OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
MINDLOGIC_API_KEY=your-mindlogic-api-key
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent

# 포렌식 도구 탐지: 팀 MCP 서버(dissect-mcp, pst-mcp) venv를 찾을 루트 디렉터리
# PATH처럼 ':'로 구분. 미설정 시 agent 저장소 위치에서 형제 디렉터리를 유추
DISCOVERY_SEARCH_ROOTS=/path/to/your/projects

# LLM 실행 모드: claude_code 지정 시 API 키 대신 로컬 Claude Code 헤드리스 CLI 사용
# (미설정 시 기존 API 프로바이더 사용)
LLM_MODE=
CLAUDE_CODE_MODEL=claude-sonnet-4-5-20250929
CLAUDE_CODE_LIGHT_MODEL=claude-haiku-4-5-20251001
